# Generate a strong value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret
JWT_SECRET_KEY=replace-with-a-different-random-secret
# Local SQLite database by default. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/fairplay_api
# Flask-Migrate reads this URI from the application configuration.
DATABASE_URL=sqlite:///fairplay.db
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
